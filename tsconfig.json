{
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": true,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "importHelpers": true,
    "declaration": true,
    // (Declaration maps would point at .ts sources, which aren't published.)
    "declarationMap": false,
    "target": "es2017",
    "module": "nodenext",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    // Source maps are published next to the JavaScript, with the TypeScript
    // sources embedded (the .ts files aren't published).
    "sourceMap": true,
    "inlineSources": true,
    "lib": ["dom", "dom.asynciterable", "es2023", "esnext.asynciterable", "scripthost"],
    "newLine": "LF",
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "pretty": true,
    "jsx": "react",
    "strict": true,
    "types": ["jest", "node"],
    // Apollo Client 4 does not publish its test support code; the vendored tests use a copy.
    "paths": { "@apollo/client/testing/internal": ["./test/src/testing/internal/index.ts"] }
  },
  "exclude": ["node_modules", "apollo-client", "dist", ".claude", "test/src"]
}
